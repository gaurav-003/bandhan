{
  "name": "bandhan-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc && mkdir -p dist/public && cp -r public/. dist/public/",
    "start": "node dist/src/index.js",
    "seed": "tsx prisma/seed.ts",
    "build:prod": "npm install && npx prisma migrate deploy && npm run build",
    "migrate:deploy": "prisma migrate deploy",
    "cleanup:unverified": "tsx scripts/cleanup-unverified.ts",
    "backup": "bash scripts/backup.sh",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.12.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "prisma": "^6.14.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
