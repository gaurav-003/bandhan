# Bandhan backend — env vars (example). Asli values .env me rakho, git me mat dalna.
# Copy: cp .env.example .env  (phir apne values bharo)

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (Unix socket format — pgserver setup ke liye)
DATABASE_URL=postgresql://bandhan_app:PASSWORD@localhost/bandhan?host=/home/hatch/workspace/bandhan-backend/pgdata

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT (random 32-byte hex — kabhi share mat karo)
JWT_SECRET=CHANGE_ME_RANDOM_32_BYTE_HEX
JWT_EXPIRES_IN=7d

# ---- Email confirmation flow ----
# Website ka URL — confirm ke baad user yahan redirect hota hai.
# Local testing: http://127.0.0.1:3000
# Production: Bandhan site ka asli URL (jaise https://bandhan.app)
FRONTEND_URL=http://127.0.0.1:3000

# Backend ka public URL — confirmation mail me ye link jata hai.
# Local testing: http://127.0.0.1:4000
# Production: backend ka asli URL (jaise https://api.bandhan.app)
API_BASE_URL=http://127.0.0.1:4000

# ---- SMTP (real email bhejne ke liye) ----
# Khali chhodo to Ethereal TEST account use hota hai — email asal me kisi ko
# nahi jata, sirf console pe preview URL milta hai (testing ke liye).
# Real mail ke liye Gmail app password chahiye:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tumhara-email@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   (16-digit app password, normal password NAHI)
#   SMTP_FROM=Bandhan <tumhara-email@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bandhan <noreply@bandhan.app>
