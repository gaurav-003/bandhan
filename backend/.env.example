# Bandhan backend — env vars (example). Asli values .env me rakho, git me mat dalna.
# Copy: cp .env.example .env  (phir apne values bharo)

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL — pooled URL (app) + direct URL (migrations).
# Local pgserver: dono me wahi socket URL daalo.
# Neon/Supabase: DATABASE_URL me pooled (?pgbouncer=true) URL, DIRECT_URL me direct URL.
DATABASE_URL=postgresql://user:password@host:5432/bandhan?host=/path/to/socket
DIRECT_URL=postgresql://user:password@host:5432/bandhan?host=/path/to/socket

# Redis (local ya Upstash — Upstash ka URL yahan daalo)
REDIS_URL=redis://127.0.0.1:6379

# JWT (random 32-byte hex — kabhi share mat karo)
JWT_SECRET=change-me-to-a-random-32-byte-hex
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-byte-hex
# Access token 15 min, refresh token 7 din (code me fixed hain, env se override nahi hote)
JWT_EXPIRES_IN=15m

# ---- Frontend / API URLs ----
# Website ka URL — confirm ke baad user yahan redirect hota hai.
# Local testing: http://127.0.0.1:3000 — comma-separated list bhi chalti hai.
# Production: Bandhan site ka asli URL (jaise https://bandhan.app)
FRONTEND_URL=http://127.0.0.1:3000,http://localhost:3000

# Backend ka public URL — confirmation mail me ye link jata hai.
API_BASE_URL=http://127.0.0.1:4000

# ---- Email (mail provider abstraction) ----
# MAIL_PROVIDER=log | brevo | resend
# log = koi key nahi chahiye, mail console pe log hota hai (local dev/testing).
# brevo = abhi ke liye ye use karo (sender email Brevo dashboard me verify karo).
# resend = domain aane ke baad (domain verify karke).
MAIL_PROVIDER=log
BREVO_API_KEY=
BREVO_SENDER=Bandhan <noreply@bandhan.app>
RESEND_API_KEY=
RESEND_SENDER=Bandhan <noreply@bandhan.app>
# Purana Gmail SMTP hata diya gaya hai — SMTP_* vars ab use nahi hote.

# ---- Photo storage (storage provider abstraction) ----
# STORAGE_PROVIDER=local | cloudinary | supabase
# local = dev/testing ke liye, files ./uploads me (public serve NAHI hoti,
# sirf signed URL endpoint se milti hain). Production me cloudinary/supabase lo.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=bandhan-photos

# ---- Razorpay (payment) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Monitoring / backup (P2, optional) ----
SENTRY_DSN=
